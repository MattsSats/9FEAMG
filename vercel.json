{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/p/:slug",
      "destination": "/api/parlay?slug=:slug"
    }
  ],
  "crons": [
    {
      "path": "/api/yahoo/sync",
      "schedule": "0 11 * * *"
    }
  ],
  "functions": {
    "api/og.js": {
      "includeFiles": "api/_fonts/**"
    }
  }
}
