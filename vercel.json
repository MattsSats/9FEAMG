{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/p/:slug",
      "destination": "/api/parlay?slug=:slug"
    },
    {
      "source": "/draft",
      "destination": "/draft/index.html"
    },
    {
      "source": "/s/:name",
      "destination": "/api/section?name=:name"
    }
  ],
  "crons": [
    {
      "path": "/api/yahoo/sync",
      "schedule": "0 11 * * *"
    }
  ],
  "functions": {
    "api/og.js": {
      "includeFiles": "{api/_fonts/**,node_modules/harfbuzzjs/hb.wasm,node_modules/@resvg/resvg-wasm/index_bg.wasm}"
    },
    "api/section.js": {
      "includeFiles": "{api/_fonts/**,node_modules/harfbuzzjs/hb.wasm,node_modules/@resvg/resvg-wasm/index_bg.wasm}"
    },
    "api/league.js": {
      "maxDuration": 60
    },
    "api/live.js": {
      "maxDuration": 30
    }
  }
}
